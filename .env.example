# Copy to .env. Deployed values live in the Vercel "webapp" project.
# Contract: docs/deployment/DEPLOYMENT.md · Studio: studio/.env.example

# Sanity project ID: https://www.sanity.io/manage → your project → shown under its name. Not a secret.
# Required: paste YOUR project ID (deployment guide, notebook value N1). Empty = clear build error.
NUXT_PUBLIC_SANITY_PROJECT_ID=

# Use `development` locally — never develop against production content.
NUXT_PUBLIC_SANITY_DATASET=development

# Public URL of the site (canonical, hreflang, sitemap).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# `production` makes the site indexable by search engines. Anything else is noindex.
NUXT_SITE_ENV=local

# Optional — defaults to "Landing Page".
# NUXT_PUBLIC_SITE_NAME=Landing Page

# Optional: the EmailJS account the contact form sends through (public values, docs/contact/EMAILJS.md
# §8). Any of the three empty: the contact page shows an email link instead of the form.
NUXT_PUBLIC_EMAILJS_SERVICE_ID=
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# Optional: the Google Tag Manager container of this environment (GTM-XXXXXXX). Empty: no
# analytics at all, and the consent window does not offer statistics. GTM loads only after the
# visitor accepts statistics. The same container in every environment (docs/analytics/GTM.md,
# docs/deployment/DEPLOYMENT.md).
NUXT_PUBLIC_GTM_ID=
