# Copy to .env. Deployed values live in the Vercel "webapp" project.
# Contract: docs/deployment/DEPLOYMENT.md · Studio: studio/.env.example

# Sanity project ID: https://www.sanity.io/manage → your project → shown under its name. Not a secret.
# Required: paste YOUR project ID (deployment guide, notebook value N1). Empty = clear build error.
NUXT_PUBLIC_SANITY_PROJECT_ID=

# Use `staging` locally — never develop against production content.
NUXT_PUBLIC_SANITY_DATASET=staging

# Public URL of the site (canonical, hreflang, sitemap).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# `production` makes the site indexable by search engines. Anything else is noindex.
NUXT_SITE_ENV=development

# Optional — defaults to "Landing Page".
# NUXT_PUBLIC_SITE_NAME=Landing Page

# Optional: your form's endpoint at an EU form service, e.g. https://forms.example.eu/f/your-form-id
# (deployment guide, section 3.2). Empty: the contact page shows an email link instead of the form.
NUXT_PUBLIC_CONTACT_FORM_ACTION=
# Platforms that provide a GDPR-compliant form endpoint (EU-hosted, no tracking, no cookies):
#  - PostTo (https://postto.dev/)
#  - Formward (https://formward.eu/gdpr-form-backend)
#  - Forminit (https://forminit.com/)
#  - Formhook (https://formhook.app/)
#  - SimplyForms (https://simplyforms.app/en)