{
  "name": "landing-page-base",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "concurrently --names web,studio --prefix-colors green,magenta \"nuxt dev\" \"pnpm --filter landing-page-studio dev\"",
    "build": "nuxt build",
    "build:e2e": "node tests/e2e/build.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck && pnpm --filter landing-page-studio typecheck",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage",
    "typegen": "pnpm --filter landing-page-studio typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test smoke",
    "lighthouse": "node tests/lighthouse/lighthouse.ts",
    "design:capture": "node tests/visual/design.ts capture",
    "design:verify": "node tests/visual/design.ts verify",
    "studio:build": "pnpm --filter landing-page-studio build",
    "studio:seed": "pnpm --filter landing-page-studio seed"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^6.2.4",
    "@nuxtjs/sanity": "^2.5.0",
    "@nuxtjs/sitemap": "^8.6.1",
    "@portabletext/vue": "^1.0.14",
    "@sanity/client": "^7.27.0",
    "groqd": "^1.7.1",
    "nuxt": "^4.5.2",
    "nuxt-schema-org": "^6.4.3",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.139",
    "@lhci/cli": "^0.15.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "groq-js": "^2.0.0",
    "h3-next": "npm:h3@^2.0.1-rc.32",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
