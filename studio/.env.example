# ═══════════════════════════════════════════════════════════════════════════════
# SANITY STUDIO — local environment
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to studio/.env. Deployed values live in the Vercel "studio" project.
# Contract: docs/deployment/DEPLOYMENT.md

# Sanity project ID: https://www.sanity.io/manage → your project → shown under its name.
# Required: paste YOUR project ID (deployment guide, notebook value N1). Empty = clear build error.
SANITY_STUDIO_PROJECT_ID=

# Use `staging` locally — never edit production content from your laptop.
SANITY_STUDIO_DATASET=staging
